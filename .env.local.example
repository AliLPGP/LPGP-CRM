# ============================================================================
# LPGP Connect CRM -- environment variables
# Copy to .env.local for local dev, and add the same names in Vercel
# (Project -> Settings -> Environment Variables) for production.
#
# ENVIRONMENT.md in this repo is the full guide: what each value does, what
# breaks without it, and the three secrets that must match the ops panel.
# The ops panel has its own .env.example in the TrackerLPGP repo.
# ============================================================================

# --- Supabase (Project → Settings → API) -----------------------------------
# Used by the browser + server to READ data. Safe to expose (anon, RLS-guarded).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only key used for WRITES (importing leads, editing profiles, notes).
# NEVER expose this to the browser or commit it. Server routes only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# --- Lusha (https://dashboard.lusha.com → API) ------------------------------
# REST API key the in-app import tool uses to pull leads. Server-only.
LUSHA_API_KEY=your-lusha-api-key

# --- Auth / admins ----------------------------------------------------------
# The app uses Supabase Auth (email + password). Enable the Email provider in
# Supabase → Authentication → Providers, and create your teammates in
# Authentication → Users. Each gets a `profiles` row automatically on first
# sign-in.
#
# Comma-separated emails that should be super admins (can allocate/reassign
# leads to anyone). You can also set profiles.role = 'admin' directly in SQL.
ADMIN_EMAILS=you@company.com

# --- Ops panel bridge (TrackerLPGP) -----------------------------------------
# Connects the sales CRM to the ops panel, so adding a company to the pipeline
# surfaces any deal it already has there and which events its money is
# allocated to. Both values are server-only; nothing reaches the browser.
#
# OPS_PANEL_URL is the tracker's deployed origin (no trailing slash).
# OPS_BRIDGE_KEY is a shared secret you invent — set the SAME value on the
# tracker (Vercel → TrackerLPGP → Settings → Environment Variables).
# Generate one with:  openssl rand -hex 32
#
# Leave both unset and the CRM simply hides every ops-panel feature.
OPS_PANEL_URL=https://your-tracker.vercel.app
OPS_BRIDGE_KEY=paste-the-same-secret-on-both-apps

# Optional, and off by default. Set this (to a DIFFERENT secret, also mirrored
# on the tracker) to let the sales CRM record deals and attach invoices in the
# ops panel — so accounts can work from here while the tracker stays the single
# source of truth for money. Two secrets on purpose: a leaked read key must
# never be able to create a financial record.
# OPS_BRIDGE_WRITE_KEY=a-second-different-secret

# --- AI thesis search (optional) --------------------------------------------
# Discover reads every search with built-in rules instantly. With this set,
# Claude (claude-opus-5-5) also re-reads each search into the same filters a
# second later, which catches phrasings the rules miss. Server-only. Leave it
# unset and Discover works exactly the same, rules only.
# ANTHROPIC_API_KEY=sk-ant-...
