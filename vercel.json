{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "pnpm next build",
  "installCommand": "pnpm install",
  "outputDirectory": ".next",
  "regions": ["dub1"],
  "crons": [
    {
      "path": "/api/directory/signals/refresh",
      "schedule": "20 6 * * *"
    },
    {
      "path": "/api/directory/benchmarks/research",
      "schedule": "40 6 1-8 * *"
    },
    {
      "path": "/api/accounts/sync",
      "schedule": "50 6 * * *"
    },
    {
      "path": "/api/directory/portcos/enrich",
      "schedule": "10 7 * * *"
    }
  ]
}
